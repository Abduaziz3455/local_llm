# =============================================================================
#  Configuration for docker-compose.yml
#  Keep this file next to docker-compose.yml — `docker compose` reads it
#  automatically. After changing anything here: docker compose up -d
# =============================================================================

# --- Ports (host side) -------------------------------------------------------
# Change these if 3000 / 8080 are already in use on your machine.
# The containers' internal ports stay 8080; only the host mapping changes.
WEBUI_PORT=5000      # dashboard ->            http://localhost:3000
LLAMA_PORT=5002      # raw OpenAI-compatible -> http://localhost:8080/v1

# --- Model selection ---------------------------------------------------------
# Folder name under your HuggingFace hub cache (the "models--ORG--REPO" dir).
MODEL_REPO=models--unsloth--Qwen3.6-35B-A3B-GGUF

# Optional: pin one quant if the repo holds several (e.g. UD-Q4_K_XL).
# Leave blank to auto-pick the first .gguf found.
QUANT=UD-Q4_K_XL

# MoE expert offloading (Qwen3.6-35B-A3B). The model (~23 GB) is too big for a
# 12 GB GPU, so its expert layers live in system RAM. 99 = all experts on CPU
# (safe). Lower the number to move experts onto the GPU for speed — raise back
# up if `nvidia-smi` shows the GPU near full or you hit a CUDA OOM at startup.
N_CPU_MOE=30

# --- HuggingFace fallback ----------------------------------------------------
# If the model above isn't found in the local cache, download it from
# HuggingFace on first start. Format: ORG/REPO:QUANT (llama.cpp -hf format).
# Leave blank to disable the fallback (local-only).
HF_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_XL

# Token for gated/private repos (optional). Create one at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Paths -------------------------------------------------------------------
# Location of your HuggingFace hub cache (the dir containing the models--* folders).
HF_HUB=/home/username/.cache/huggingface/hub

# =============================================================================
#  Telegram assistant bot
#  Used by the 'bot' service. See README.md → "Telegram assistant bot".
# =============================================================================

# Token from @BotFather. Also enable "Guest Mode" in BotFather's MiniApp so the
# bot can be summoned by @mention in any chat.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id(s) allowed to use the bot (ask @userinfobot).
# Comma-separate to grant access to several admins. The legacy single-value
# ADMIN_USER_ID is still accepted as a fallback.
ADMIN_USER_IDS=

# Open WebUI API — reached over the internal Docker network (container port 8080,
# NOT the host WEBUI_PORT). Generate the key in Open WebUI → Settings → Account.
OPENWEBUI_URL=http://open-webui:8080
OPENWEBUI_API_KEY=

# Open WebUI model-entry ids: one fast (thinking off), one thinking (thinking on).
# Create both in Open WebUI → Workspace → Models; ids must match exactly.
MODEL_FAST=qwen-fast
MODEL_THINKING=qwen-thinking

# Optional tuning.
HISTORY_TURNS=12         # past messages replayed for context in DM chats
REQUEST_TIMEOUT=180      # seconds to wait on the model before giving up
FILE_TTL_HOURS=24        # how long an uploaded doc stays attached for RAG
MAX_STORED_MESSAGES=200  # messages kept per chat; older ones are pruned

# --- Poll tool-calling -------------------------------------------------------
# The bot can create/close Telegram polls via function calling. Poll decisions
# bypass Open WebUI and hit llama-swap directly (Open WebUI mangles tool calls).
LLAMA_URL=http://llama:8080/v1   # internal Docker link to the llama-swap proxy
LLAMA_API_KEY=local              # matches --api-key in start-llama.sh
POLL_MODEL=gemma-4-12b           # model that decides + fills poll tool calls
POLLS_ENABLED=true               # set false to disable the poll feature
