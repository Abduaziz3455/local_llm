# =============================================================================
#  Configuration for docker-compose.yml
#  Keep this file next to docker-compose.yml — `docker compose` reads it
#  automatically. After changing anything here: docker compose up -d
# =============================================================================

# --- Ports (host side) -------------------------------------------------------
# Change these if 3000 / 8080 are already in use on your machine.
# The containers' internal ports stay 8080; only the host mapping changes.
WEBUI_PORT=3000      # dashboard ->            http://localhost:3000
LLAMA_PORT=8080      # raw OpenAI-compatible -> http://localhost:8080/v1

# --- Model selection ---------------------------------------------------------
# Folder name under your HuggingFace hub cache (the "models--ORG--REPO" dir).
MODEL_REPO=models--unsloth--Qwen3.5-9B-GGUF

# Optional: pin one quant if the repo holds several (e.g. UD-Q4_K_XL).
# Leave blank to auto-pick the first .gguf found.
QUANT=UD-Q4_K_XL

# --- Paths -------------------------------------------------------------------
# Location of your HuggingFace hub cache (the dir containing the models--* folders).
HF_HUB=/home/abduaziz/.cache/huggingface/hub